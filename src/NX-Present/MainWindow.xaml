<Window x:Class="NXPresent.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:NXPresent" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="NX-Present · Show Control" Width="1500" Height="940" MinWidth="1120" MinHeight="740"
 WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource Bg}" Foreground="{StaticResource Ink}"
 FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
 AllowDrop="True" Drop="FilesDropped" Closing="WindowClosing" PreviewKeyDown="WindowKeyDown">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <!-- Custom dark title bar. WindowChrome retains native move / resize / snap. -->
  <Border Background="#101314" BorderBrush="#2B3234" BorderThickness="0,0,0,1">
   <Grid Margin="16,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="NX" Foreground="{StaticResource Accent}" FontWeight="Black" FontStyle="Italic" FontSize="23"/><TextBlock Text="/" Foreground="#546062" FontSize="21" Margin="12,0"/><TextBlock Text="PRESENT" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="SHOW CONTROL SYSTEM" Style="{StaticResource Eyebrow}" FontSize="10" Margin="22,0,0,0" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource QuietButton}" Width="43" MinHeight="0" ToolTip="Minimieren" AutomationProperties.Name="Minimieren" Click="MinimizeWindow"/><Button x:Name="MaximizeButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource QuietButton}" Width="43" MinHeight="0" ToolTip="Maximieren / Wiederherstellen" AutomationProperties.Name="Maximieren" Click="MaximizeWindow"/><Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource QuietButton}" Width="46" MinHeight="0" ToolTip="Programm beenden" AutomationProperties.Name="Programm beenden" Click="ExitProgram"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#101314" BorderBrush="#2B3234" BorderThickness="0,0,1,0">
    <DockPanel Margin="0,12,0,10">
     <StackPanel DockPanel.Dock="Bottom"><Button Click="ShowHelp" Style="{StaticResource QuietButton}" Margin="8" ToolTip="Hilfe und Tastenkürzel" AutomationProperties.Name="Hilfe"><TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="19"/></Button><TextBlock Text="V 0.3" Style="{StaticResource Eyebrow}" FontSize="10" HorizontalAlignment="Center" Margin="0,9,0,3"/></StackPanel>
     <StackPanel>
      <RadioButton x:Name="ShowNav" Tag="show" GroupName="Navigation" Style="{StaticResource NavButton}" IsChecked="True" Checked="NavigationChanged" AutomationProperties.Name="Show Control"><StackPanel><TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="Show" FontSize="10" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel></RadioButton>
      <RadioButton x:Name="SettingsNav" Tag="settings" GroupName="Navigation" Style="{StaticResource NavButton}" Checked="NavigationChanged" AutomationProperties.Name="Einstellungen"><StackPanel><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="21" HorizontalAlignment="Center"/><TextBlock Text="Setup" FontSize="10" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel></RadioButton>
     </StackPanel>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1" Margin="24,0,24,0">
    <Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="Show Control" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Vorbereiten. Prüfen. Live schalten." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
     <Button Grid.Column="1" Click="OpenSettingsPage" Style="{StaticResource QuietButton}" Margin="16,0,20,0" VerticalAlignment="Center" ToolTip="Ausgabe und Geräte einrichten"><StackPanel Orientation="Horizontal"><Ellipse x:Name="OutputDot" Width="6" Height="6" Fill="#657174" Margin="0,0,8,0"/><TextBlock x:Name="OutputBadge" Text="AUSGABE AUS" FontFamily="Consolas" FontSize="11"/></StackPanel></Button>
     <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,24,0"><TextBlock x:Name="ControlClock" Text="00:00:00" FontFamily="Consolas" FontSize="24" HorizontalAlignment="Right"/><TextBlock x:Name="ControlDate" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0"/></StackPanel>
     <Button x:Name="BlackButton" Width="160" Grid.Column="3" Content="SCHWARZ + STUMM" Click="ToggleBlack" Background="#141718" BorderBrush="#707B7D" Padding="17,11" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" IsEnabled="False" ToolTip="Ausgabe sofort verdecken und Ton stummschalten"/>
    </Grid>
    <!-- SHOW WORKSPACE -->
    <Grid x:Name="WorkspacePage" Grid.Row="1">
     <Grid.ColumnDefinitions><ColumnDefinition Width="286"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <local:ChamferBorder Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" Cut="8" Padding="15">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid Margin="0,2,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="01 / QUELLEN" Style="{StaticResource Eyebrow}"/><TextBlock Text="Bibliothek" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><Button x:Name="AddContentButton" Grid.Column="1" Content="+ Inhalt" Click="OpenAddMenu" VerticalAlignment="Center" Padding="10,7"><Button.ContextMenu><ContextMenu><MenuItem Header="Bilder / Videos hinzufügen …" Click="AddFiles"/><MenuItem Header="Webseite hinzufügen …" Click="OpenWebsiteEditor"/><MenuItem Header="Text hinzufügen …" Click="OpenTextEditor"/><Separator/><MenuItem Header="Uhr vorbereiten" Click="PrepareClock"/><MenuItem Header="NX-Startbild vorbereiten" Click="PrepareLogo"/></ContextMenu></Button.ContextMenu></Button></Grid>
       <Grid x:Name="LibraryBrowser" Grid.Row="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <UniformGrid Columns="3" Margin="0,0,0,12"><RadioButton x:Name="AllFilter" Content="Alle" GroupName="LibraryFilter" Tag="all" Style="{StaticResource FilterButton}" IsChecked="True" Checked="LibraryFilterChanged"/><RadioButton Content="Medien" GroupName="LibraryFilter" Tag="media" Style="{StaticResource FilterButton}" Checked="LibraryFilterChanged"/><RadioButton Content="Testbilder" GroupName="LibraryFilter" Tag="patterns" Style="{StaticResource FilterButton}" Checked="LibraryFilterChanged"/></UniformGrid>
        <Grid Grid.Row="1" Margin="0,0,0,12"><TextBox x:Name="LibrarySearch" Padding="30,8,9,8" TextChanged="SearchChanged" ToolTip="Bibliothek durchsuchen" AutomationProperties.Name="Bibliothek durchsuchen"/><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/><TextBlock Text="Suchen …" Margin="31,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=LibrarySearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
        <Grid Grid.Row="2"><ListBox x:Name="CueList" SelectionChanged="CueSelected" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions><local:ChamferBorder Width="32" Height="34" Background="#0F1213" BorderBrush="#3B4547" Cut="4" VerticalAlignment="Center"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#BFC8C8"/></local:ChamferBorder><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Category}" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="9" Margin="0,5,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="EmptyLibrary" Text="Keine passenden Inhalte.&#x0a;Füge Dateien oder eine Webseite hinzu." Style="{StaticResource Hint}" Margin="12,28" Visibility="Collapsed" IsHitTestVisible="False"/></Grid>
        <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CueCount" Text="0 INHALTE" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource QuietButton}" Click="RemoveCue" Padding="9,6" ToolTip="Ausgewählten Inhalt aus der Bibliothek entfernen" AutomationProperties.Name="Inhalt entfernen"/></Grid>
       </Grid>
       <Grid x:Name="LibraryEditor" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Content="←  Zur Bibliothek" Style="{StaticResource QuietButton}" Click="CloseLibraryEditor" HorizontalAlignment="Left" Padding="0,8" Margin="0,0,0,16"/><StackPanel Grid.Row="1"><StackPanel x:Name="WebsiteEditor"><TextBlock Text="Webseite" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Internetadresse" Style="{StaticResource Hint}" Margin="0,18,0,6"/><TextBox x:Name="UrlInput" Text="https://" ToolTip="Internetadresse" AutomationProperties.Name="Internetadresse"/><TextBlock Text="Die Seite wird zuerst in der stummen Vorschau geöffnet." Style="{StaticResource Hint}" Margin="0,12,0,18"/><Button Content="Zur Vorschau hinzufügen" Style="{StaticResource PrimaryButton}" Click="PrepareWebsite"/></StackPanel><StackPanel x:Name="TextEditor" Visibility="Collapsed"><TextBlock Text="Text" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Text für die Leinwand" Style="{StaticResource Hint}" Margin="0,18,0,6"/><TextBox x:Name="CueTextInput" Height="185" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" ToolTip="Text für die Projektionsfläche" AutomationProperties.Name="Text für die Leinwand"/><Button Content="Zur Vorschau hinzufügen" Style="{StaticResource PrimaryButton}" Click="PrepareText" Margin="0,16,0,0"/></StackPanel></StackPanel></Grid>
       <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="1"/><RowDefinition/></Grid.RowDefinitions><Line X2="240" Stroke="#4A5557" StrokeDashArray="4,4" Stretch="Fill"/><TextBlock Grid.Row="1" Text="Auswählen bereitet nur vor.&#x0a;Die Leinwand bleibt unverändert." Style="{StaticResource Hint}" FontSize="11" Margin="0,12,0,0"/></Grid>
      </Grid>
     </local:ChamferBorder>
     <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
      <StackPanel>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <local:ChamferBorder Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" Cut="8" Padding="16"><StackPanel>
         <Grid Margin="0,1,0,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="02 / VORBEREITUNG" Style="{StaticResource Eyebrow}"/><TextBlock Grid.Column="1" Text="STUMM" Style="{StaticResource Eyebrow}" FontSize="9"/></Grid>
         <Border x:Name="PreviewFrame" Background="Black" Height="220" SizeChanged="PreviewSized"><Grid x:Name="PreviewHost"/></Border>
         <TextBlock x:Name="PreparedName" Text="Noch kein Inhalt" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" Margin="0,16,0,5"/><TextBlock x:Name="PreparedDetail" Text="Wähle links einen Inhalt aus." Style="{StaticResource Hint}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </StackPanel></local:ChamferBorder>
        <local:ChamferBorder Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="#687822" Cut="8" Padding="16"><StackPanel>
         <Grid Margin="0,1,0,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="03 / LEINWAND" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Accent}"/><TextBlock x:Name="LiveHeading" Grid.Column="1" Text="AUS" Foreground="{StaticResource Accent}" FontFamily="Consolas" FontSize="9" MaxWidth="180" TextTrimming="CharacterEllipsis"/></Grid>
         <Border Background="Black" Height="{Binding ActualHeight, ElementName=PreviewFrame}"><Grid><Image x:Name="LiveImage" Stretch="Uniform"/><Border x:Name="LiveVectorHost" Visibility="Collapsed" IsHitTestVisible="False"/><StackPanel x:Name="LivePlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Foreground="#495456" FontSize="28" HorizontalAlignment="Center"/><TextBlock Text="Ausgabe ist geschlossen" Foreground="#899597" FontSize="11" Margin="0,14,0,0"/></StackPanel></Grid></Border>
         <TextBlock x:Name="LiveName" Text="Kein Live-Inhalt" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" Margin="0,16,0,5"/><TextBlock Text="Live-Ansicht · Video/Web: Kontrollbild ca. 1×/s" Style="{StaticResource Hint}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        </StackPanel></local:ChamferBorder>
       </Grid>
       <local:ChamferBorder Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" Cut="8" Padding="18" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="ÜBERGANG" Style="{StaticResource Eyebrow}" FontSize="10" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal"><ComboBox x:Name="TransitionPicker" Width="146" SelectedIndex="1" SelectionChanged="TransitionSelectionChanged" ToolTip="Übergangsart"><ComboBoxItem Content="Sofort"/><ComboBoxItem Content="Überblenden"/><ComboBoxItem Content="Über Schwarz"/></ComboBox><ComboBox x:Name="DurationPicker" Width="82" SelectedIndex="1" Margin="8,0,0,0" ToolTip="Dauer des Übergangs"><ComboBoxItem Content="0,25 s" Tag="250"/><ComboBoxItem Content="0,5 s" Tag="500"/><ComboBoxItem Content="1 s" Tag="1000"/><ComboBoxItem Content="1,5 s" Tag="1500"/><ComboBoxItem Content="2 s" Tag="2000"/></ComboBox></StackPanel></StackPanel>
        <Button x:Name="GoLiveButton" Grid.Column="2" Click="GoLive" Style="{StaticResource PrimaryButton}" Padding="24,12" IsEnabled="False" MinWidth="182"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Live anzeigen" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="STRG + ENTER" FontSize="9" FontFamily="Consolas" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="→" FontSize="25" Margin="22,0,0,0" VerticalAlignment="Center"/></Grid></Button>
       </Grid></local:ChamferBorder>
       <local:ChamferBorder x:Name="VideoTransport" Visibility="Collapsed" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" Cut="7" Padding="15" Margin="0,14,0,0"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button Content="&#xE769;" FontFamily="Segoe MDL2 Assets" Click="PauseLive" ToolTip="Pause" AutomationProperties.Name="Pause" Margin="0,0,5,0"/><Button Content="&#xE768;" FontFamily="Segoe MDL2 Assets" Click="ResumeLive" ToolTip="Weiter" AutomationProperties.Name="Weiter" Margin="0,0,5,0"/><Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Click="RestartLive" ToolTip="Von vorn" AutomationProperties.Name="Von vorn"/></StackPanel><TextBlock x:Name="TimeLabel" Grid.Column="2" Text="00:00 / 00:00" FontFamily="Consolas" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Grid><Slider x:Name="SeekBar" Minimum="0" Maximum="1" PreviewMouseLeftButtonDown="SeekStarted" PreviewMouseLeftButtonUp="SeekFinished" IsMoveToPointEnabled="True" Margin="0,10,0,0" ToolTip="Videoposition"/></StackPanel></local:ChamferBorder>
       <Button x:Name="WebReloadButton" Visibility="Collapsed" Content="↻  Webseite neu laden" Click="ReloadLive" HorizontalAlignment="Right" Margin="0,14,0,0"/>
       <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Dateien kannst du auch direkt in die Bibliothek ziehen." Foreground="#788487" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Ausgabe starten" x:Name="StartQuickButton" Click="StartOutput" Padding="13,7"/></Grid>
      </StackPanel>
     </ScrollViewer>
    </Grid>
    <!-- SETTINGS: separate surface, no hidden overlapping browser windows. -->
    <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel MaxWidth="1040" HorizontalAlignment="Left" Margin="0,0,10,4">
      <local:ChamferBorder Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" Cut="8" Padding="23" Margin="0,0,0,16"><StackPanel><TextBlock Text="01 / BILDAUSGABE" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Accent}"/><TextBlock Text="Leinwand &amp; Ausgabeschutz" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Ausgabe-Bildschirm" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><ComboBox x:Name="DisplayPicker" Grid.Column="1" MinWidth="300"/><Button Grid.Column="2" Content="Neu erkennen" Click="RefreshDisplays" Margin="10,0,0,0"/></Grid><StackPanel Margin="180,14,0,0"><CheckBox x:Name="Protection" Content="Maus und andere Fenster von der Leinwand fernhalten" IsChecked="True" Checked="ProtectionChanged" Unchecked="ProtectionChanged"/><CheckBox x:Name="AutoStartOutput" Content="Beim Programmstart Ausgabe mit Schwarzbild einschalten" IsChecked="True"/><WrapPanel Margin="0,14,0,0"><Button x:Name="StartOutputButton" Content="Ausgabe starten" Click="StartOutput" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button x:Name="StopOutputButton" Content="Ausgabe schließen" Click="StopOutput" IsEnabled="False"/></WrapPanel><TextBlock Text="Globaler Notausstieg: Strg + Alt + F10 gibt Bildschirm und Maus frei." Style="{StaticResource Hint}" Margin="0,14,0,0"/></StackPanel></StackPanel></local:ChamferBorder>
      <local:ChamferBorder Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" Cut="8" Padding="23" Margin="0,0,0,16"><StackPanel><TextBlock Text="02 / AUDIO" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Accent}"/><TextBlock Text="Ton &amp; Wiedergabe" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Gemeinsames Audiogerät" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><ComboBox x:Name="AudioPicker" Grid.Column="1" MinWidth="300"/><Button Grid.Column="2" Content="Ton anwenden" Click="ApplyAudio" Margin="10,0,0,0"/></Grid><StackPanel Margin="180,12,0,0"><TextBlock Text="Ändert das Windows-Standardgerät für Videos, Webseiten und andere Programme. Beim Beenden wird die vorherige Auswahl wiederhergestellt." Style="{StaticResource Hint}"/><Button Content="Audiogeräte neu erkennen" Click="RefreshAudio" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="0,8" Margin="0,3,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="220"/><ColumnDefinition Width="60"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Lautstärke" VerticalAlignment="Center"/><Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="80" ValueChanged="VolumeChanged" ToolTip="Videolautstärke"/><TextBlock Grid.Column="2" Text="{Binding Value, ElementName=VolumeSlider, StringFormat={}{0:0}%}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/><CheckBox x:Name="MuteLive" Grid.Column="3" Content="Stumm" Checked="PlaybackOptionsChanged" Unchecked="PlaybackOptionsChanged"/></Grid><CheckBox x:Name="RepeatVideo" Content="Videodateien wiederholen" Checked="PlaybackOptionsChanged" Unchecked="PlaybackOptionsChanged" Margin="0,12,0,0"/></StackPanel></StackPanel></local:ChamferBorder>
      <local:ChamferBorder Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" Cut="8" Padding="23" Margin="0,0,0,16"><StackPanel><TextBlock Text="03 / DARSTELLUNG" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Accent}"/><TextBlock Text="Bilder &amp; Testsignale" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Bilddarstellung" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><ComboBox x:Name="FitPicker" Grid.Column="1" SelectionChanged="FitChanged" SelectedIndex="0"><ComboBoxItem Content="Einpassen (mit Rändern)"/><ComboBoxItem Content="Füllen (beschneiden)"/><ComboBoxItem Content="Strecken"/></ComboBox></Grid><StackPanel Margin="180,12,0,0"><TextBlock Text="Gilt für Standbilder. Videos behalten ihr Seitenverhältnis." Style="{StaticResource Hint}"/><CheckBox x:Name="PatternMotion" Content="Testbilder animieren" IsChecked="True" Checked="PatternAnimationChanged" Unchecked="PatternAnimationChanged" Margin="0,16,0,6"/></StackPanel></StackPanel></local:ChamferBorder>
      <local:ChamferBorder Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" Cut="8" Padding="23"><StackPanel><TextBlock Text="04 / SHOW &amp; PROGRAMM" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Accent}"/><TextBlock Text="Sitzung &amp; Dateien" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,16"/><TextBlock Text="Einstellungen und Bibliothek werden automatisch gespeichert. Eine Showdatei lässt sich zusätzlich separat sichern oder laden." Style="{StaticResource Hint}" Margin="0,0,0,16"/><WrapPanel><Button Content="Show öffnen …" Click="OpenShow" Margin="0,0,8,8"/><Button Content="Show speichern …" Click="SaveShow" Margin="0,0,8,8"/><Button Content="Hilfe &amp; Tastenkürzel" Click="ShowHelp" Margin="0,0,8,8"/><Button Content="Programm beenden" Click="ExitProgram" Foreground="#FFB4AA" BorderBrush="#71504B" Background="#241A19" Margin="0,0,0,8"/></WrapPanel></StackPanel></local:ChamferBorder>
     </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="HelpPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel MaxWidth="1000" HorizontalAlignment="Left" Margin="0,0,14,8">
      <local:ChamferBorder Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" Cut="8" Padding="25" Margin="0,0,0,16"><StackPanel><TextBlock Text="DER WEG AUF DIE LEINWAND" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Accent}"/><TextBlock Text="Wählen → Prüfen → Live schalten" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,17"/><TextBlock Text="Wähle einen Inhalt aus der Bibliothek. Bilder und Videos, Webseiten und Texte fügst du über + Inhalt hinzu. Die stumme Vorbereitung zeigt, was als Nächstes kommen soll. Erst Live anzeigen oder Strg + Enter übernimmt den Inhalt auf die Leinwand." Style="{StaticResource Hint}"/><TextBlock Text="Übergang und Dauer wählst du direkt am Live-Knopf. Sofort wechselt direkt, Überblenden hält das bisherige Bild als Standbild und blendet es aus, Über Schwarz führt den Wechsel durch ein Schwarzbild. Es gibt keine Audioüberblendung." Style="{StaticResource Hint}" Margin="0,14,0,0"/></StackPanel></local:ChamferBorder>
      <local:ChamferBorder Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" Cut="8" Padding="25" Margin="0,0,0,16"><StackPanel><TextBlock Text="IM LAUFENDEN BETRIEB" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Accent}"/><TextBlock Text="Schwarzbild &amp; schneller Ausstieg" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,17"/><TextBlock Text="Schwarz + stumm im Kopfbereich verdeckt den Inhalt sofort und schaltet den Ton aus. Der gelbe Knopf Bild freigeben macht ihn wieder sichtbar. Videos laufen während des Schwarzbilds weiter." Style="{StaticResource Hint}"/><local:ChamferBorder Background="#20270F" BorderBrush="#687C23" Dashed="True" Padding="14" Cut="5" Margin="0,18,0,16"><StackPanel><TextBlock Text="STRG + ALT + F10" Foreground="{StaticResource Accent}" FontFamily="Consolas" FontSize="19"/><TextBlock Text="Schließt die Beamer-Ausgabe und gibt die Maus frei. Das Steuerfenster bleibt geöffnet." Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel></local:ChamferBorder><TextBlock Text="Die Uhr ist ein eigener Inhalt. Testbilder lassen sich unter Setup animieren oder anhalten. Das Ausgabefenster wird vorn gehalten; Windows-Systemdialoge können darüber liegen." Style="{StaticResource Hint}"/></StackPanel></local:ChamferBorder>
      <local:ChamferBorder Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" Cut="8" Padding="25" Margin="0,0,0,16"><StackPanel><TextBlock Text="GERÄTE &amp; DATEIEN" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Accent}"/><TextBlock Text="Alles Weitere im Setup" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,17"/><TextBlock Text="Das Zahnrad öffnet Bildschirm, gemeinsamen Ton, Startverhalten und Bilddarstellung. Die Tonauswahl ändert das Windows-Standardgerät für alle Programme und stellt es beim Beenden wieder her. Die Videolautstärke wird in NX-Present geregelt; Webseiten verwenden ihre eigene Lautstärke. Stumm wirkt auch auf Webseiten." Style="{StaticResource Hint}"/><TextBlock Text="Einstellungen und Bibliothek werden automatisch gespeichert. Showdateien speichern Verweise auf Medien; beim Umziehen müssen die Dateien mitgenommen werden. Programm beenden und das X schließen die gesamte Anwendung und geben die Ausgabe frei." Style="{StaticResource Hint}" Margin="0,14,0,0"/><TextBlock Text="Webseiten werden live neu geladen. Anmeldungen und Eingaben aus der Vorschau werden nicht übernommen. Downloads, Kamera und Mikrofon sind deaktiviert. GIFs erscheinen als Standbild." Style="{StaticResource Hint}" Margin="0,14,0,0"/></StackPanel></local:ChamferBorder>
      <Button Content="Zurück zur Show" Click="BackToShow" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="20,11"/>
     </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="1"/><RowDefinition/></Grid.RowDefinitions><Line X2="1000" Stretch="Fill" Stroke="#3D484A" StrokeDashArray="4,5"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Bereit." Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><TextBlock x:Name="RenderRate" Grid.Column="1" Text="Ziel: 60 FPS" Foreground="#BAC49A" FontFamily="Consolas" FontSize="10" Margin="20,0,0,0" VerticalAlignment="Center" ToolTip="Animation zählt WPF-Aktualisierungen; keine Messung physischer Beamer-Bilder."/><TextBlock Grid.Column="2" Text="STRG + ALT + F10 · AUSSTIEG" Foreground="#9AA584" FontFamily="Consolas" FontSize="10" Margin="24,0,0,0" VerticalAlignment="Center"/></Grid></Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
