<UserControl x:Class="NXPresent.MonitorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:NXPresent">
 <Border x:Name="Frame" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="12,8,12,7">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border x:Name="Lamp" Width="10" Height="10" CornerRadius="5" Margin="0,0,9,0" VerticalAlignment="Center"/>
    <TextBlock x:Name="Title" Grid.Column="1" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
    <TextBlock x:Name="Badge" Grid.Column="2" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
   </Grid>
   <local:AspectBox Grid.Row="1" Margin="10,0">
    <Border x:Name="Tally" BorderThickness="2" Background="Black">
     <local:MixerSurface x:Name="Surface"/>
    </Border>
   </local:AspectBox>
   <Grid Grid.Row="2" Margin="12,8,12,8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock x:Name="NameText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="DetailText" Style="{StaticResource Eyebrow}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <TextBlock x:Name="TimeText" Grid.Column="1" Style="{StaticResource Mono}" FontSize="12" VerticalAlignment="Top" Margin="12,2,0,0"/>
   </Grid>
   <Grid x:Name="TransportRow" Grid.Row="3" Margin="12,0,12,10" Visibility="Collapsed">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button x:Name="RestartButton" Content="&#xE892;" FontFamily="Segoe MDL2 Assets" Padding="0" Width="34" MinHeight="28" Focusable="False" Click="RestartClicked" ToolTip="Von vorn" AutomationProperties.Name="Von vorn"/>
    <Button x:Name="PlayButton" Grid.Column="1" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" Padding="0" Width="34" MinHeight="28" Margin="4,0,8,0" Focusable="False" Click="PlayClicked" ToolTip="Wiedergabe / Pause" AutomationProperties.Name="Wiedergabe oder Pause"/>
    <Slider x:Name="SeekBar" Grid.Column="2" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" Focusable="False" PreviewMouseLeftButtonDown="SeekStarted" PreviewMouseLeftButtonUp="SeekFinished" VerticalAlignment="Center" ToolTip="Position im Video"/>
   </Grid>
  </Grid>
 </Border>
</UserControl>
