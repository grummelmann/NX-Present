<UserControl x:Class="NXPresent.CueModeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:NXPresent">
 <UserControl.Resources>
  <local:SecondsConverter x:Key="Seconds"/>
  <local:EnumMatchConverter x:Key="EnumMatch"/>
  <!-- The thin progress line under a time in the cue list. -->
  <Style x:Key="MiniBar" TargetType="ProgressBar">
   <Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="1"/><Setter Property="Height" Value="3"/><Setter Property="Margin" Value="0,3,0,0"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="Background" Value="Transparent"/><Setter Property="IsHitTestVisible" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid><Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="1.5"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="1.5"/></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RunBar" TargetType="ProgressBar" BasedOn="{StaticResource MiniBar}"><Setter Property="Foreground" Value="{StaticResource Program}"/></Style>
  <!-- A colour flag in the inspector. -->
  <Style x:Key="Swatch" TargetType="RadioButton">
   <Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid Background="Transparent">
    <Ellipse Fill="{TemplateBinding Background}" Stroke="{StaticResource LineStrong}" StrokeThickness="1" Margin="2"/>
    <Ellipse x:Name="Ring" Stroke="{StaticResource Ink}" StrokeThickness="2" Visibility="Collapsed"/>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CueRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
   <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,2"/>
   <Style.Triggers><DataTrigger Binding="{Binding Armed}" Value="False"><Setter Property="Opacity" Value="0.45"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="TimeText" TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>

  <!-- Run bar: GO, stop, playhead -->
  <Border Grid.ColumnSpan="5" Style="{StaticResource PanelBorder}" Padding="14,10" Margin="0,0,0,10"><Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="GoButton" Focusable="False" Click="GoClicked" Style="{StaticResource PrimaryButton}" Padding="26,4" MinWidth="150" Height="54" IsEnabled="False" ToolTip="Den Cue an der Marke starten (Leertaste, Strg + Enter)" AutomationProperties.Name="GO"><StackPanel><TextBlock Text="GO" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="LEERTASTE" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" Opacity="0.7"/></StackPanel></Button>
   <Button x:Name="StopButton" Focusable="False" Grid.Column="1" Click="StopClicked" Style="{StaticResource DangerButton}" Margin="10,0,0,0" MinWidth="92" Height="54" IsEnabled="False" ToolTip="Alle wartenden und laufenden Cues stoppen (Esc). Ein laufender Übergang endet von selbst." AutomationProperties.Name="Stopp"><StackPanel><TextBlock Text="STOPP" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="ESC" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" Opacity="0.7"/></StackPanel></Button>
   <Button x:Name="ResetButton" Focusable="False" Grid.Column="2" Click="ResetClicked" Margin="10,0,0,0" MinWidth="92" Height="54" ToolTip="Die Marke an den Anfang setzen. Das Programm bleibt unverändert." AutomationProperties.Name="Zurück an den Anfang"><StackPanel><TextBlock Text="ZURÜCK" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="AN DEN ANFANG" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" Opacity="0.7"/></StackPanel></Button>
   <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="22,0,12,0">
    <TextBlock Text="MARKE · NÄCHSTER CUE" Style="{StaticResource Eyebrow}" FontSize="9"/>
    <TextBlock x:Name="NextText" Text="Kein Cue" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
    <TextBlock x:Name="RunStatus" Style="{StaticResource Hint}" FontSize="11" LineHeight="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0"/>
   </StackPanel>
   <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,16,0">
    <TextBlock Text="GEHE ZU CUE" Style="{StaticResource Eyebrow}" FontSize="9" Margin="0,0,0,4"/>
    <TextBox x:Name="JumpBox" Width="86" MinHeight="26" Padding="8,3" KeyDown="JumpKeyDown" ToolTip="Nummer eingeben und Eingabetaste drücken: die Marke springt dorthin" AutomationProperties.Name="Zu Cue-Nummer springen"/>
   </StackPanel>
   <StackPanel x:Name="FileTools" Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Show öffnen" Click="OpenClicked" Margin="0,0,6,0" MinHeight="28" Padding="10,3"/><Button Content="Show speichern" Click="SaveClicked" MinHeight="28" Padding="10,3"/></StackPanel>
  </Grid></Border>

  <!-- Sources from the pool -->
  <Border x:Name="SourcePanel" Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="12">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="QUELLEN" Style="{StaticResource SectionTitle}"/><TextBlock Text="Aus dem Medienpool" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,8"><TextBox x:Name="SourceSearch" TextChanged="SourceSearchChanged" ToolTip="Medienpool durchsuchen" AutomationProperties.Name="Quellen für den Cue-Ablauf durchsuchen" Padding="26,5,8,5"/><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/><TextBlock Text="Suchen …" Margin="27,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Dim}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SourceSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    <ListBox x:Name="SourceList" Grid.Row="2" SelectionChanged="SourceSelectionChanged" MouseDoubleClick="SourceDoubleClicked" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Verfügbare Cue-Quellen"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" Style="{StaticResource Eyebrow}" FontSize="9" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    <StackPanel Grid.Row="3" Margin="0,10,0,0"><Button x:Name="AddButton" Focusable="False" Content="+ Zum Ablauf" Click="AddClicked" Style="{StaticResource PrimaryButton}" IsEnabled="False" ToolTip="Die gewählte Quelle als Cue hinter der Marke einfügen (oder Doppelklick)"/><Button Content="Neue Inhalte im Mischer" Click="LibraryClicked" Style="{StaticResource QuietButton}" Margin="0,4,0,0" FontSize="11" ToolTip="Zur Seite Mischer wechseln"/></StackPanel>
   </Grid>
  </Border>

  <!-- The cue list -->
  <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="12,12,6,10">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,6,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="CUE-LISTE" Style="{StaticResource SectionTitle}" Margin="0"/><TextBlock x:Name="CountLabel" Text="0 CUES" Style="{StaticResource Eyebrow}" Margin="12,0,0,0"/></StackPanel>
     <StackPanel x:Name="EditTools" Grid.Column="1" Orientation="Horizontal">
      <Button x:Name="AddCueButton" Focusable="False" Content="+ Cue  ▾" Click="AddCueMenuClicked" Style="{StaticResource PrimaryButton}" MinHeight="26" Padding="10,2" Margin="0,0,5,0" ToolTip="Einen Cue einfügen: Schwarz, Lautstärke, Video, Warten oder Notiz"><Button.ContextMenu><ContextMenu>
       <MenuItem Header="Schwarz (nach Schwarz oder zurück)" Tag="{x:Static local:RunCueType.Black}" Click="AddTypeClicked"/>
       <MenuItem Header="Lautstärke blenden" Tag="{x:Static local:RunCueType.Volume}" Click="AddTypeClicked"/>
       <MenuItem Header="Video steuern (Pause, Fortsetzen, Von vorn)" Tag="{x:Static local:RunCueType.Video}" Click="AddTypeClicked"/>
       <Separator/>
       <MenuItem Header="Warten" Tag="{x:Static local:RunCueType.Wait}" Click="AddTypeClicked"/>
       <MenuItem Header="Notiz (Merker ohne Wirkung)" Tag="{x:Static local:RunCueType.Memo}" Click="AddTypeClicked"/>
      </ContextMenu></Button.ContextMenu></Button>
      <Button x:Name="UpButton" Focusable="False" Content="↑" Click="UpClicked" ToolTip="Cue nach oben" AutomationProperties.Name="Cue nach oben" MinHeight="26" Padding="0" Width="30" Margin="0,0,3,0"/>
      <Button x:Name="DownButton" Focusable="False" Content="↓" Click="DownClicked" ToolTip="Cue nach unten" AutomationProperties.Name="Cue nach unten" MinHeight="26" Padding="0" Width="30" Margin="0,0,5,0"/>
      <Button x:Name="DuplicateButton" Focusable="False" Content="Duplizieren" Click="DuplicateClicked" MinHeight="26" Padding="9,2" Margin="0,0,5,0"/>
      <Button x:Name="RemoveButton" Focusable="False" Content="Entfernen" Click="RemoveClicked" MinHeight="26" Padding="9,2" Margin="0,0,5,0"/>
      <Button x:Name="RenumberButton" Focusable="False" Content="Nummern" Click="RenumberClicked" MinHeight="26" Padding="9,2" ToolTip="Alle Cues von oben nach unten mit 1, 2, 3 … nummerieren"/>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="1,0,13,5">
     <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="28"/><ColumnDefinition Width="48"/><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
     <TextBlock Grid.Column="2" Text="Q" Style="{StaticResource Eyebrow}" FontSize="9"/>
     <TextBlock Grid.Column="4" Text="CUE" Style="{StaticResource Eyebrow}" FontSize="9" Margin="4,0,0,0"/>
     <TextBlock Grid.Column="5" Text="PRE-WAIT" Style="{StaticResource Eyebrow}" FontSize="9" HorizontalAlignment="Right" Margin="0,0,6,0"/>
     <TextBlock Grid.Column="6" Text="DAUER" Style="{StaticResource Eyebrow}" FontSize="9" HorizontalAlignment="Right" Margin="0,0,6,0"/>
     <TextBlock Grid.Column="7" Text="POST-WAIT" Style="{StaticResource Eyebrow}" FontSize="9" HorizontalAlignment="Right" Margin="0,0,6,0"/>
     <TextBlock Grid.Column="8" Text="↓" Style="{StaticResource Eyebrow}" FontSize="10" HorizontalAlignment="Center" ToolTip="Weiter: Auto-Continue ↓ oder Auto-Follow ⇓"/>
    </Grid>
    <Grid Grid.Row="2">
     <ListBox x:Name="RunList" ItemsSource="{Binding Items}" SelectedItem="{Binding Next, Mode=TwoWay}" ItemContainerStyle="{StaticResource CueRow}" ScrollViewer.VerticalScrollBarVisibility="Visible" VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Cue-Liste">
      <ListBox.ItemTemplate><DataTemplate>
       <Grid Height="42" ToolTip="{Binding Tip}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="28"/><ColumnDefinition Width="48"/><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
        <Border Background="{Binding ColorBrush}" CornerRadius="2" Margin="0,4"/>
        <TextBlock Grid.Column="1" Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}" FontFamily="Segoe MDL2 Assets" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding Number}" FontFamily="Consolas" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="2,0,0,0"/>
        <TextBlock Grid.Column="3" Text="{Binding Glyph}" Foreground="{StaticResource Muted}" FontFamily="Segoe MDL2 Assets" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="4,0,8,0">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsMemo}" Value="True"><Setter Property="FontStyle" Value="Italic"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <Border Grid.Column="1" Background="{StaticResource Program}" CornerRadius="2" Padding="5,1" Margin="8,0,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsLive}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="LIVE" Foreground="White" FontWeight="Bold" FontSize="9"/></Border>
         </Grid>
         <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Eyebrow}" FontSize="10" FontWeight="Normal" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,6,0"><TextBlock Text="{Binding PreText}" Style="{StaticResource TimeText}"/><ProgressBar Value="{Binding PreProgress, Mode=OneWay}" Style="{StaticResource MiniBar}"/></StackPanel>
        <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="0,0,6,0"><TextBlock Text="{Binding DurationText}" Style="{StaticResource TimeText}"/><ProgressBar Value="{Binding ActionProgress, Mode=OneWay}" Style="{StaticResource RunBar}"/></StackPanel>
        <StackPanel Grid.Column="7" VerticalAlignment="Center" Margin="0,0,6,0"><TextBlock Text="{Binding PostText}" Style="{StaticResource TimeText}"/><ProgressBar Value="{Binding PostProgress, Mode=OneWay}" Style="{StaticResource MiniBar}"/></StackPanel>
        <TextBlock Grid.Column="8" Text="{Binding ContinueGlyph}" Foreground="{StaticResource Accent}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding ContinueLabel}"/>
       </Grid>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock x:Name="EmptyHint" Text="Die Cue-Liste ist noch leer.&#x0a;Wähle links eine Quelle und füge sie hinzu,&#x0a;oder lege über „+ Cue“ Schwarz, Warten oder Notizen an." Style="{StaticResource Hint}" Margin="10,22" IsHitTestVisible="False"/>
    </Grid>
   </Grid>
  </Border>

  <!-- Monitors -->
  <ScrollViewer Grid.Row="1" Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,0,2">
   <local:MonitorView x:Name="NextMonitor" Mode="Preview" Heading="VORSCHAU"/>
   <local:MonitorView x:Name="LiveMonitor" Mode="Program" Heading="PROGRAMM" Margin="0,10,0,0"/>
  </StackPanel></ScrollViewer>

  <!-- Inspector -->
  <Border Grid.Row="2" Grid.ColumnSpan="5" Style="{StaticResource PanelBorder}" Padding="14,10,14,12" Margin="0,10,0,0">
   <Grid x:Name="CueEditor" IsEnabled="False">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal">
      <TextBlock Text="INSPEKTOR" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,16,0"/>
      <RadioButton x:Name="TabBasics" Content="Grundlagen" GroupName="InspectorTab" Style="{StaticResource FilterButton}" IsChecked="True" Checked="InspectorTabChanged"/>
      <RadioButton x:Name="TabTime" Content="Zeit und Weiter" GroupName="InspectorTab" Style="{StaticResource FilterButton}" Checked="InspectorTabChanged"/>
      <RadioButton x:Name="TabAction" Content="Aktion" GroupName="InspectorTab" Style="{StaticResource FilterButton}" Checked="InspectorTabChanged"/>
      <RadioButton x:Name="TabTrigger" Content="Taste" GroupName="InspectorTab" Style="{StaticResource FilterButton}" Checked="InspectorTabChanged"/>
     </StackPanel>
     <TextBlock Grid.Column="2" Text="{Binding TypeLabel, StringFormat={}TYP · {0}}" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
    </Grid>
    <Grid Grid.Row="1" MinHeight="100">
     <!-- Basics -->
     <Grid x:Name="PanelBasics"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="520"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*" MaxWidth="560"/></Grid.ColumnDefinitions>
      <StackPanel>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Nummer" Style="{StaticResource Hint}" Margin="0,0,0,4"/><TextBox x:Name="NumberBox" MinHeight="28" LostFocus="NumberCommitted" KeyDown="NumberKeyDown" ToolTip="Die Cue-Nummer, zum Beispiel 12 oder 12.5. Jede Nummer gibt es nur einmal." AutomationProperties.Name="Cue-Nummer"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Name" Style="{StaticResource Hint}" Margin="0,0,0,4"/><Grid><TextBox x:Name="NameBox" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" ToolTip="Eigener Name; leer verwendet den Namen der Quelle" AutomationProperties.Name="Cue-Name"/><TextBlock Text="{Binding DefaultName}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Dim}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=NameBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></StackPanel>
       </Grid>
       <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Farbe" Style="{StaticResource Hint}" Margin="0,0,12,0" VerticalAlignment="Center"/><StackPanel x:Name="SwatchPanel" Orientation="Horizontal"/></StackPanel>
        <CheckBox x:Name="ArmedBox" Grid.Column="1" Content="Aktiv (sonst übersprungen)" IsChecked="{Binding Armed}" HorizontalAlignment="Right" Margin="12,0,0,0" Focusable="False" ToolTip="Ausgeschaltete Cues werden beim Weiterschalten der Marke übersprungen und starten nicht"/>
       </Grid>
      </StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Regienotiz" Style="{StaticResource Hint}" Margin="0,0,0,4"/><TextBox x:Name="NotesBox" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="76" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Regienotiz"/></StackPanel>
     </Grid>
     <!-- Time -->
     <Grid x:Name="PanelTime" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
       <StackPanel Margin="0,0,10,0"><TextBlock Text="Pre-Wait" Style="{StaticResource Hint}" Margin="0,0,0,4"/><TextBox x:Name="PreBox" Width="96" MinHeight="28" Text="{Binding PreWaitMilliseconds, Converter={StaticResource Seconds}, UpdateSourceTrigger=LostFocus}" LostFocus="TimeCommitted" KeyDown="TimeKeyDown" ToolTip="Wartezeit, bevor der Cue nach GO loslegt" AutomationProperties.Name="Pre-Wait"/></StackPanel>
       <StackPanel Margin="0,0,10,0"><TextBlock Text="Dauer" Style="{StaticResource Hint}" Margin="0,0,0,4"/><TextBox x:Name="DurationBox" Width="96" MinHeight="28" Text="{Binding DurationMilliseconds, Converter={StaticResource Seconds}, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding UsesDuration}" LostFocus="TimeCommitted" KeyDown="TimeKeyDown" ToolTip="Dauer des Übergangs, der Blende oder der Pause" AutomationProperties.Name="Dauer"/></StackPanel>
       <StackPanel><TextBlock Text="Post-Wait" Style="{StaticResource Hint}" Margin="0,0,0,4"/><TextBox x:Name="PostBox" Width="96" MinHeight="28" Text="{Binding PostWaitMilliseconds, Converter={StaticResource Seconds}, UpdateSourceTrigger=LostFocus}" LostFocus="TimeCommitted" KeyDown="TimeKeyDown" ToolTip="Wartezeit bis zum automatischen Start des nächsten Cues" AutomationProperties.Name="Post-Wait"/></StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="2" MaxWidth="640" HorizontalAlignment="Left">
       <TextBlock Text="Danach" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
       <StackPanel Orientation="Horizontal">
        <RadioButton Content="Nicht fortfahren" GroupName="ContinueMode" Style="{StaticResource FilterButton}" IsChecked="{Binding Continue, Converter={StaticResource EnumMatch}, ConverterParameter=None}"/>
        <RadioButton Content="Auto-Continue  ↓" GroupName="ContinueMode" Style="{StaticResource FilterButton}" IsChecked="{Binding Continue, Converter={StaticResource EnumMatch}, ConverterParameter=AutoContinue}"/>
        <RadioButton Content="Auto-Follow  ⇓" GroupName="ContinueMode" Style="{StaticResource FilterButton}" IsChecked="{Binding Continue, Converter={StaticResource EnumMatch}, ConverterParameter=AutoFollow}"/>
       </StackPanel>
       <TextBlock Text="{Binding ContinueHint}" Style="{StaticResource Hint}" FontSize="11" Margin="0,8,0,0"/>
      </StackPanel>
     </Grid>
     <!-- Action (depends on the type) -->
     <Grid x:Name="PanelAction" Visibility="Collapsed">
      <StackPanel MaxWidth="760" HorizontalAlignment="Left"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="Source"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Quelle" Style="{StaticResource Hint}" Margin="0,0,0,4"/><ComboBox x:Name="TargetPicker" SelectedItem="{Binding Cue, Mode=TwoWay}" DisplayMemberPath="Name" ToolTip="Die Quelle, die dieser Cue auf Programm bringt" AutomationProperties.Name="Quelle des Cues"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Übergang" Style="{StaticResource Hint}" Margin="0,0,0,4"/><ComboBox x:Name="TransitionPicker" SelectedValue="{Binding Transition}" SelectedValuePath="Tag" AutomationProperties.Name="Übergang"><ComboBoxItem Content="Sofort" Tag="{x:Static local:TransitionKind.Cut}"/><ComboBoxItem Content="Überblenden" Tag="{x:Static local:TransitionKind.Dissolve}"/><ComboBoxItem Content="Über Schwarz" Tag="{x:Static local:TransitionKind.ThroughBlack}"/><ComboBoxItem Content="Wischen →" Tag="{x:Static local:TransitionKind.WipeHorizontal}"/><ComboBoxItem Content="Wischen ↓" Tag="{x:Static local:TransitionKind.WipeVertical}"/><ComboBoxItem Content="Iris" Tag="{x:Static local:TransitionKind.Iris}"/><ComboBoxItem Content="Schieben" Tag="{x:Static local:TransitionKind.Push}"/></ComboBox></StackPanel>
       </Grid>
       <TextBlock Text="Die Quelle wird beim Wechsel zur Marke vorgeladen, so startet GO ohne Verzögerung. Die Dauer des Übergangs stellst du im Reiter „Zeit und Weiter“ ein. Es läuft immer nur ein Übergang; weitere Cues warten, bis er fertig ist." Style="{StaticResource Hint}" FontSize="11" Margin="0,10,0,0"/>
      </StackPanel>
      <StackPanel MaxWidth="560" HorizontalAlignment="Left"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="Black"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
       <TextBlock Text="Richtung" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
       <ComboBox Width="260" HorizontalAlignment="Left" SelectedValue="{Binding Action}" SelectedValuePath="Tag" AutomationProperties.Name="Richtung der Schwarzblende"><ComboBoxItem Content="Weich nach Schwarz" Tag="{x:Static local:CueAction.BlackOut}"/><ComboBoxItem Content="Zurück aus Schwarz" Tag="{x:Static local:CueAction.BlackIn}"/></ComboBox>
       <TextBlock Text="Blendet das Programm samt Ton nach Schwarz oder wieder zurück, wie FTB im Mischer. Die Dauer stellst du im Reiter „Zeit und Weiter“ ein." Style="{StaticResource Hint}" FontSize="11" Margin="0,10,0,0"/>
      </StackPanel>
      <StackPanel MaxWidth="560" HorizontalAlignment="Left"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="Volume"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
       <TextBlock Text="{Binding Level, StringFormat={}Ziel: {0} % der Hauptlautstärke}" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
       <Slider Minimum="0" Maximum="100" Value="{Binding Level}" TickFrequency="5" IsSnapToTickEnabled="True" Focusable="False" AutomationProperties.Name="Ziel-Lautstärke"/>
       <TextBlock Text="Blendet die Hauptlautstärke des Mischers in der Dauer auf diesen Wert. Auch die Lautstärke im Mischer bewegt sich mit." Style="{StaticResource Hint}" FontSize="11" Margin="0,10,0,0"/>
      </StackPanel>
      <StackPanel MaxWidth="560" HorizontalAlignment="Left"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="Video"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
       <TextBlock Text="Aktion" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
       <ComboBox Width="260" HorizontalAlignment="Left" SelectedValue="{Binding Action}" SelectedValuePath="Tag" AutomationProperties.Name="Aktion für das Video"><ComboBoxItem Content="Video pausieren" Tag="{x:Static local:CueAction.Pause}"/><ComboBoxItem Content="Video fortsetzen" Tag="{x:Static local:CueAction.Resume}"/><ComboBoxItem Content="Video von vorn" Tag="{x:Static local:CueAction.Restart}"/></ComboBox>
       <TextBlock Text="Wirkt auf das Video, das im Programm läuft. Läuft dort keines, passiert nichts und der Ablauf geht weiter." Style="{StaticResource Hint}" FontSize="11" Margin="0,10,0,0"/>
      </StackPanel>
      <TextBlock MaxWidth="560" HorizontalAlignment="Left" Text="Dieser Cue hat keine weiteren Einstellungen. Name, Zeiten und die Notiz findest du in den anderen Reitern."><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Hint}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="Wait"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Type}" Value="Memo"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid>
     <!-- Trigger -->
     <StackPanel x:Name="PanelTrigger" Visibility="Collapsed" MaxWidth="640" HorizontalAlignment="Left">
      <TextBlock Text="Taste" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
      <ComboBox x:Name="HotkeyPicker" Width="200" HorizontalAlignment="Left" SelectionChanged="HotkeyChanged" AutomationProperties.Name="Taste für diesen Cue"/>
      <TextBlock Text="Die Taste startet diesen Cue sofort, wann immer du willst, auch ohne dass die Marke dort steht. Die Marke bewegt sich dabei nicht. Die Taste gilt auf der Cue-Seite, solange kein Textfeld aktiv ist; jede Taste gehört zu einem Cue." Style="{StaticResource Hint}" FontSize="11" Margin="0,10,0,0"/>
     </StackPanel>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</UserControl>
